{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Baumzeit",
  "version": "0.4.0",
  "identifier": "de.baumzeit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Baumzeit",
        "width": 900,
        "height": 720,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": false
      },
      {
        "label": "mini",
        "title": "Baumzeit Mini",
        "url": "index.html?view=mini",
        "width": 248,
        "height": 92,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; media-src 'self' blob: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost https://ipc.localhost http://localhost:1420 ws://localhost:1420; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Baumzeit",
    "category": "Productivity",
    "shortDescription": "Fokus-Timer mit wachsendem Wald",
    "longDescription": "Baumzeit ist ein ruhiger Fokus-Timer: WÃ¤hrend des Lernens wÃ¤chst ein Baum, am Ende wird er in deinem Wald gepflanzt.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German"],
        "displayLanguageSelector": false
      }
    }
  }
}
